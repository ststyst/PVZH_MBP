; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PVZH_MBP"
config/description="卡牌对决：收集、构筑与对战的卡牌回合制游戏（Godot 4.7.2）。"
run/main_scene="res://scenes/main/LoginScreen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/core/game_state.gd"
SaveManager="*res://scripts/core/save_manager.gd"
AppStorage="*res://scripts/core/app_storage.gd"
CardDatabase="*res://scripts/core/card_database.gd"
HeroDatabase="*res://scripts/core/hero_database.gd"
ModeManager="*res://scripts/core/mode_manager.gd"
CollectionManager="*res://scripts/core/collection_manager.gd"
NetManager="*res://scripts/core/net_manager.gd"
ConfirmService="*res://scripts/core/confirm_service.gd"
LoginFlow="*res://scripts/core/login_flow.gd"
DisplayService="*res://scripts/core/display_service.gd"
DeckManager="*res://scripts/core/deck_manager.gd"
BattleManager="*res://scripts/core/battle_manager.gd"
DeveloperTools="*res://scripts/core/developer_tools.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
